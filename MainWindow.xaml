<Window x:Class="Eliza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Madam Companion" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DialogBubble" Grid.Row="0" Margin="0,0,0,12" Visibility="Collapsed" HorizontalAlignment="Center">
            <Grid>
                <Border Background="White" BorderBrush="Black" BorderThickness="3.5" CornerRadius="120" Padding="30,25,30,25" MaxWidth="280" MinWidth="160">
                    <TextBlock x:Name="ChatHistory" 
                               TextWrapping="Wrap" 
                               FontFamily="Segoe UI Semibold, Segoe UI" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <Path Data="M 0,0 L 12,18 L 24,0" 
                      Fill="White" 
                      Stroke="Black" 
                      StrokeThickness="3.5" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Bottom" 
                      Margin="0,0,0,-13"/>
            </Grid>
        </Grid>

        <Image x:Name="MadamSprite" Grid.Row="1" 
               Source="madam_idle.png" 
               Width="280" Height="370"
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Bottom"
               Margin="0,0,0,-4"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="MadamSprite_MouseLeftButtonDown"/>

        <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,5">

            <Border x:Name="InputBorder" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="12" Width="230">
                <TextBox x:Name="InputField" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         Padding="8,6"
                         FontFamily="Segoe UI" 
                         FontWeight="Bold" 
                         FontSize="12"
                         HorizontalContentAlignment="Center"
                         KeyDown="InputField_KeyDown"/>
            </Border>

            <Border x:Name="ConfirmationPanel" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="12" Width="240" Visibility="Collapsed" Padding="5">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="ConfirmText" 
                               Text="Разрешить действие?" 
                               FontFamily="Segoe UI" 
                               FontWeight="Bold" 
                               FontSize="10" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               Margin="0,2,0,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Разрешить ❤️" 
                                Click="AllowButton_Click" 
                                Width="95" Height="22" 
                                Background="Black" Foreground="White" 
                                FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" 
                                BorderThickness="0" Margin="0,0,5,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Отклонить" 
                                Click="DenyButton_Click" 
                                Width="95" Height="22" 
                                Background="White" Foreground="Black" 
                                FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" 
                                BorderBrush="Black" BorderThickness="2">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>